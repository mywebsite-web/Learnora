rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin authorization strictly restricted to adedayoademola171@gmail.com
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'adedayoademola171@gmail.com'
      );
    }

    // User-scoped profiles and private configuration
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{userId} {
      allow read, list: if true;
      allow create, update: if !(userId in ['usr_y0na13', 'demo_user']) &&
                              !exists(/databases/$(database)/documents/deleted_users/$(userId));
      allow delete: if true;
    }
    match /subscriptions/{userId} {
      allow read, write: if true;
    }
    match /usage/{userId} {
      allow read, write: if true;
    }
    match /achievements/{userId} {
      allow read, write: if true;
    }
    match /cognitiveMemories/{userId} {
      allow read, write: if true;
    }

    // Platform announcements / broadcast
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Study Sets
    match /studySets/{setId} {
      allow read, write: if true;
    }

    // Review Queue (Spaced Repetition 1, 3, 7 days)
    match /reviewQueue/{reviewId} {
      allow read, write: if true;
    }

    // Structured Notes
    match /notes/{noteId} {
      allow read, write: if true;
    }

    // Flashcards
    match /flashcards/{cardId} {
      allow read, write: if true;
    }

    // Flashcard Progress
    match /flashcardProgress/{progId} {
      allow read, write: if true;
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Practice Tests
    match /practiceTests/{testId} {
      allow read, write: if true;
    }

    // Practice Test Attempts
    match /testAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Study Plans
    match /studyPlans/{planId} {
      allow read, write: if true;
    }

    // Study Sessions
    match /studySessions/{sessionId} {
      allow read, write: if true;
    }

    // Calendar Events
    match /calendarEvents/{eventId} {
      allow read, write: if true;
    }

    // Tutor Sessions
    match /tutorSessions/{sessionId} {
      allow read, write: if true;
    }

    // Tutor Messages
    match /tutorMessages/{messageId} {
      allow read, write: if true;
    }

    // Audio Lessons
    match /audioLessons/{lessonId} {
      allow read, write: if true;
    }

    // Video Lessons
    match /videoLessons/{videoId} {
      allow read, write: if true;
    }

    // Lectures
    match /lectures/{lectureId} {
      allow read, write: if true;
    }

    // Essay Feedback
    match /essays/{essayId} {
      allow read, write: if true;
    }

    // Teaching Styles
    match /teachingStyles/{styleId} {
      allow read, write: if true;
    }

    // Teaching Evolution Logs (Nora's Self-Learning Record)
    match /teachingEvolutionLogs/{logId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Push Devices & Subscriptions
    match /pushDevices/{deviceId} {
      allow read, write: if true;
    }
    match /pushTokens/{tokenId} {
      allow read, write: if true;
    }

    // User Complaints & Help Desk Tickets
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Community & Group Study Lounge Messages
    match /community_messages/{messageId} {
      allow read, write: if true;
    }

    // Active User Online Presence
    match /presence/{userId} {
      allow read: if true;
      allow create, update: if !(userId in ['usr_y0na13', 'demo_user']) &&
                              !exists(/databases/$(database)/documents/deleted_users/$(userId));
      allow delete: if true;
    }

    // Tombstones for Deleted Users & Emails
    match /deleted_users/{userId} {
      allow read, write: if true;
    }
    match /deleted_emails/{emailId} {
      allow read, write: if true;
    }
  }
}
